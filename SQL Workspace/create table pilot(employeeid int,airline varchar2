create table sales3(category varchar2(100),"2015" int,"2016" int, "2017" int, "2018" int);

insert into sales3 values('Hard Drinks',2000,1500,1200,2000);
insert into sales3 values('Soft Drinks',1000,1800,1200,2000);


select * from sales3
unpivot(
    amount for years in ("2015","2016","2017","2018")
);

select * from (
    select category,'2015' as years,"2015" as amount from sales3
    union
    select category,'2016' as years,"2016" as amount from sales3
    union
    select category,'2017' as years,"2017" as amount from sales3
    union
    select category,'2018' as years,"2018" as amount from sales3
)


